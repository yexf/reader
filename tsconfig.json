{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["scripts/**/*.ts", "test/**/*.ts"],
  "exclude": ["test/*.ts"]
}
